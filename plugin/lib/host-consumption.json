    { "anchor": "optionSelected", "kind": "css-module-substring", "callSites": ["lib/client.js"], "note": "宿主 CSS module 局部类名子串——非契约面，宿主改名即静默失效（0.2.2-rc.1 提问卡 DOM 双层化即此类破坏，已配机械守卫）" },
    { "anchor": "descriptionToggle", "kind": "css-module-substring", "callSites": ["lib/client.js"], "note": "同上，:not() 排除锚点" },
    { "anchor": "cardMinimized", "kind": "css-module-substring", "callSites": ["lib/client.js"], "note": "同上" }
