    { "key": "locale", "consumedVia": "inject", "callSites": ["lib/client.js"], "note": "同上" },
    { "key": "uiConversation", "consumedVia": "inject", "callSites": ["lib/client.js"], "note": "同上；@deepseek-ai/dsh-client-ui-conversation 为声明的 client.inject 依赖" },
    { "key": "configForms", "consumedVia": "ctx.inject(soft)", "callSites": ["lib/client.js"], "note": "软注入（宿主缺失时降级），同上" },
