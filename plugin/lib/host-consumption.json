{
  "$comment": "机器可读消费面清单 — Norm host-upgrade-followup (norm-e188af99) 第 4 步三态判定的比对基准。每一项都必须有代码调用点（callSites 为 plugin/ 相对路径，由 test/host-consumption-consistency.test.mjs 与 lib/*.js 双向核对：清单缺项或代码新增未登记消费点都会被抓）。plane 说明差分通道：host-service/host-event 走 api-catalog.ts 三表，client-slot 走 slot-catalog.ts，value-service 与 client-service 无仓内生成物目录（差分报 uncheckable），non-contract 是宿主未承诺的锚点（宿主改名即静默失效）。",
  "version": 1,
  "hostServices": [
    { "key": "tools", "plane": "host-service", "consumedVia": "inject + ctx.get", "callSites": ["lib/index.js", "lib/host-seams.js"], "note": "ctx.tools.register / ctx.tools.guard（specs/10 §5.2）" },
    { "key": "systemPrompt", "plane": "host-service", "consumedVia": "inject", "callSites": ["lib/index.js"], "note": "引导面注入（specs/10 §5.3）" },
    { "key": "userQuestions", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/host-seams.js"], "note": "ctx.userQuestions.ask — Human Gate 承载；缺失时 fail-closed（friction-95fa6df2 相关面）" },
    { "key": "fs", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/host-seams.js"], "note": "fs 服务与 fs/observed 挂载点" },
    { "key": "invariants", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/host-seams.js"], "note": "ctx.invariants.register — 宿主 0.2.1 线已移除（remove-runtime-invariants），本插件按 specs/10 §6 报告 absent/not consumed；保留在清单是为了「已消失的消费面」继续被差分器盯住" },
    { "key": "agents", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/child.js", "lib/lifecycle.js"], "note": "agent 事件派发与子代理面" },
    { "key": "commands", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/index.js"], "note": "registerLdvhCommands（定义在 lib/rpc.js，经 index.js 的 ctx.get(\"commands\") 取得服务）" },
    { "key": "goals", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/lifecycle.js", "lib/workcase-goals.js"], "note": "goal 服务（宿主辅助任务面）" },
    { "key": "schedule", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/host-automation-probe.js", "lib/ldvh-tools.js"], "note": "0.2.2 线已重建（schedule-agent-tools）——差分器须能再次报出同类破坏" },
    { "key": "sessionController", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/host-automation-probe.js", "lib/ldvh-tools.js"], "note": "会话控制探测面" },
    { "key": "sessionPersistence", "plane": "host-service", "consumedVia": "ctx.get", "callSites": ["lib/child-session-record.js", "lib/lifecycle.js", "lib/session-signature.js"], "note": "sessionPersistence.open" },
    { "key": "subagents", "plane": "host-service", "consumedVia": "agent.ctx.get?.(可选链)", "callSites": ["lib/lifecycle.js"], "note": "startActivation/list/getProvider — 受管辖隔离子代理派发面（独立复核/摩擦发现/经验审核均经此）；0.2.1-rc.1 的 subagent-activations 破坏即落在此面（start/startContinuable 移除、SubagentRun.localAgent 消失）。服务经 agent.ctx 可选链取得后作参数传入 friction-discovery-provider.js/experience-review-stage.js/workcase-tools.js，故 callSites 仅列有 .get 字面调用的 lifecycle.js" },
    { "key": "webServer", "plane": "host-service", "consumedVia": "ctx.inject", "callSites": ["lib/index.js"], "note": "webServer.register — /ldvh 路由" },
    { "key": "connection", "plane": "host-service", "consumedVia": "ctx.inject", "callSites": ["lib/index.js", "lib/rpc.js"], "note": "Web RPC 通道" }
  ],
