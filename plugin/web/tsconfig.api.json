{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".build-api",
    "noEmit": false,
    "declaration": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noCheck": true,
    "strict": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "include": ["api/**/*.ts", "shared/**/*.ts"]
}
