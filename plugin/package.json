{
  "name": "dsh-ldvh",
  "version": "1.0.0-dev.1",
  "description": "LD Vibe Harness — DeepSeek Harness 原生插件：Web 信息呈现、Git 机械守护与 AI 工作引导的宿主接入（webServer 路由 + Sidebar/全屏面板 + 设置面板）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ldvh",
    "ld-vibe-harness",
    "governance"
  ],
  "author": "dingminhua",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingminhua/dsh-ldvh.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/dingminhua/dsh-ldvh#readme",
  "bugs": {
    "url": "https://github.com/dingminhua/dsh-ldvh/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-ldvh": "lib/bin.js"
  },
  "icon": "icons/ldvh-plugin-icon-128.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icons",
    "specs",
    "cordis.patch.yml",
    "web/dist",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build:web": "cd web && pnpm build:dsh",
    "lint": "eslint .",
    "prepack": "node scripts/specs-bundle.mjs copy",
    "postpack": "node scripts/specs-bundle.mjs clean",
    "test:affected": "node scripts/affected-tests.mjs --run",
    "test:affected:plan": "node scripts/affected-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.5",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
