{
  "name": "dsh-ldvh",
  "version": "1.1.4-dev.1",
  "description": "LD Vibe Harness（LDVH） 是一个深度绑定 DSH 的 AI 协作与治理框架，核心价值：对齐 Vibe、协调 Coding。\n\n对齐 Vibe：让人与 AI 对项目的由来、现状、去向形成一致的认识。\n协调 Coding：借助宿主调度资源，明晰权责、记录火花、确立规范、构建报告、积累经验、发现摩擦，让项目进展更稳定、执行更顺利。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ldvh",
    "ld-vibe-harness",
    "governance"
  ],
  "author": "dingminhua",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingminhua/dsh-ldvh.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/dingminhua/dsh-ldvh#readme",
  "bugs": {
    "url": "https://github.com/dingminhua/dsh-ldvh/issues"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-ldvh": "lib/bin.js"
  },
  "icon": "icons/ldvh-plugin-icon-128.png",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icons",
    "docs/assets",
    "plugin-specs",
    "cordis.patch.yml",
    "web/dist",
    "web/api",
    "web/shared",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "screenshots.json",
    "web/api-js",
    "web/shared-js"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "build:web": "cd web && pnpm build:dsh",
    "lint": "eslint .",
    "prepack": "node scripts/require-version-consistency.mjs && node scripts/specs-bundle.mjs copy && node scripts/require-web-dist.mjs",
    "postpack": "node scripts/specs-bundle.mjs clean",
    "test:affected": "node scripts/affected-tests.mjs --run",
    "test:affected:plan": "node scripts/affected-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.1",
    "compression": "1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "js-yaml": "^4.1.1",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
